{
  "name": "ticash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "packages/shared"],
  "scripts": {
    "dev:api": "npm run dev --workspace @ticash/api",
    "build": "npm run build --workspace @ticash/shared && npm run build --workspace @ticash/api",
    "typecheck": "npm run typecheck --workspace @ticash/shared && npm run typecheck --workspace @ticash/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:validate": "prisma validate --schema schema.prisma",
    "prisma:generate": "prisma generate --schema schema.prisma",
    "db:push": "prisma db push --schema schema.prisma",
    "db:migrate": "prisma migrate dev --schema schema.prisma",
    "db:seed": "node scripts/seed-corridors.mjs"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "typescript": "^5.9.2"
  },
  "overrides": {"deepmerge-ts": "^8.0.0"},
  "engines": {"node": ">=20"}
}
