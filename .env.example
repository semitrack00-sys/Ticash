NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ticash:ticash_dev@localhost:5432/ticash?schema=public
# Use a non-pooled database connection for Prisma migrations and schema changes.
# For Neon, copy the Direct connection string from the Neon dashboard.
DIRECT_URL=postgresql://ticash:ticash_dev@localhost:5432/ticash?schema=public
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Legacy alias; kept for backward compatibility.
CORS_ORIGIN=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@ticash.local
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password
DEMO_EMAIL=demo@ticash.local
DEMO_PASSWORD=replace-with-a-strong-local-demo-password

# Security controls. These are application risk settings, not regulatory limits.
# Keep limits disabled until TiCash compliance/legal owners approve exact values.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
TRANSFER_LIMITS_ENABLED=false
TRANSFER_LIMIT_PER_TRANSACTION_USD=
TRANSFER_LIMIT_DAILY_USD=
TRANSFER_LIMIT_WEEKLY_USD=
TRANSFER_LIMIT_MONTHLY_USD=
RISK_REVIEW_AMOUNT_USD=
RISK_MAX_TRANSFERS_24H=
RISK_MAX_DISTINCT_RECIPIENTS_24H=
RISK_MAX_FAILED_FUNDING_24H=
RISK_RECIPIENT_CHANGE_WINDOW_MINUTES=
DATA_RETENTION_DAYS=

# Never enable either flag in the current Sandbox build. The API refuses to
# start if either is true. Sandbox compliance auto-clear is test-only and must
# remain false outside isolated automated/UAT fixtures.
SANDBOX_COMPLIANCE_AUTO_CLEAR=false
APPROVED_FOR_LIVE_USE=false
LIVE_MONEY_ENABLED=false

PAYMENTS_MODE=mock
PAYOUTS_MODE=mock
MONCASH_SANDBOX_ENABLED=true
NATCASH_SANDBOX_ENABLED=true
# Reserved for a future approved provider. The current API never exposes this method.
HAITIAN_BANK_SANDBOX_ENABLED=false

# Dwolla is backend-only and sandbox-disabled by default. Never place these
# values in Flutter, a browser bundle, or source control.
DWOLLA_ENABLED=false
DWOLLA_ENVIRONMENT=sandbox
DWOLLA_CLIENT_ID=
DWOLLA_CLIENT_SECRET=
DWOLLA_WEBHOOK_SECRET=
DWOLLA_MASTER_FUNDING_SOURCE_URL=

# All three production gates must remain false until TiCash has written Dwolla,
# corridor, payout-provider, and regulatory approval for live-money operation.
DWOLLA_PRODUCTION_ENABLED=false
DWOLLA_LIVE_FUNDING_ENABLED=false
DWOLLA_APPROVED_FOR_LIVE_USE=false

# Test-only server-side source-currency -> HTG quote engine. FX_MODE=mock is rejected when
# NODE_ENV=production. Replace it with an approved provider before live use.
FX_MODE=mock
FX_QUOTE_TTL_SECONDS=300
MOCK_FX_USD_HTG_RATE=132.500000
MOCK_FX_CAD_HTG_RATE=97.000000
MOCK_FX_EUR_HTG_RATE=145.000000
MOCK_FX_MXN_HTG_RATE=7.500000
MOCK_FX_BRL_HTG_RATE=26.000000
MOCK_FX_CLP_HTG_RATE=0.140000
MOCK_FX_DOP_HTG_RATE=2.200000
TICASH_FEE_PERCENT=2.5
TICASH_MINIMUM_FEE_USD=1.99
FX_PROVIDER_FUNDING_FEE_USD=0.00
# Optional test fee overrides denominated in each selected source currency.
TICASH_MINIMUM_FEE_CAD=1.99
TICASH_MINIMUM_FEE_EUR=1.99
TICASH_MINIMUM_FEE_MXN=1.99
TICASH_MINIMUM_FEE_BRL=1.99
TICASH_MINIMUM_FEE_CLP=1.99
TICASH_MINIMUM_FEE_DOP=1.99
FX_PROVIDER_FUNDING_FEE_CAD=0.00
FX_PROVIDER_FUNDING_FEE_EUR=0.00
FX_PROVIDER_FUNDING_FEE_MXN=0.00
FX_PROVIDER_FUNDING_FEE_BRL=0.00
FX_PROVIDER_FUNDING_FEE_CLP=0.00
FX_PROVIDER_FUNDING_FEE_DOP=0.00

# Didit is backend-only and disabled until these values are configured. Never
# place these values in Flutter, a browser bundle, logs, or source control.
DIDIT_ENABLED=false
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me

# Worldwide provider-supported Mobile Recharge Sandbox. Reloadly credentials
# stay on the backend. Recharge remains separate from remittance, the only
# supported environment is Sandbox, and all live-use gates must stay false.
MOBILE_TOPUP_ENABLED=false
MOBILE_TOPUP_PAYMENT_MODE=mock
MOBILE_TOPUP_BILLING_CURRENCY=USD
MOBILE_TOPUP_FEE_USD=0.00
MOBILE_TOPUP_QUOTE_TTL_SECONDS=300
RELOADLY_ENVIRONMENT=sandbox
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_AUTH_URL=https://auth.reloadly.com/oauth/token
RELOADLY_AIRTIME_BASE_URL=https://topups-sandbox.reloadly.com
RELOADLY_SENDER_PHONE_COUNTRY=
RELOADLY_SENDER_PHONE_NUMBER=
MOBILE_TOPUP_PRODUCTION_ENABLED=false
MOBILE_TOPUP_APPROVED_FOR_LIVE_USE=false

# Reserved for approved provider integrations. They are not consumed in mock mode.
MONCASH_BASE_URL=
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
MONCASH_WEBHOOK_SECRET=
NATCASH_BASE_URL=
NATCASH_CLIENT_ID=
NATCASH_CLIENT_SECRET=
NATCASH_WEBHOOK_SECRET=
