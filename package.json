{\n  "name": "ticash",\n  "version": "0.1.0",\n  "private": true,\n  "description": "TiCash - Remittance app for Haiti",\n  "type": "module",\n  "workspaces": [\n    "apps/web",\n    "apps/api",\n    "packages/shared"\n  ],\n  "scripts": {\n    "install": "npm install",\n    "type-check": "npm run type-check --workspaces --if-present",\n    "lint": "npm run lint --workspaces --if-present",\n    "format": "npm run format --workspaces --if-present",\n    "test:run": "npm run test:run --workspaces --if-present",\n    "build": "npm run build --workspaces --if-present",\n    "dev:api": "npm run dev -w apps/api",\n    "dev:web": "npm run start -w apps/web",\n    "db:migrate": "npm run db:migrate -w apps/api",\n    "db:push": "npm run db:push -w apps/api",\n    "db:studio": "npm run db:studio -w apps/api",\n    "docker:up": "docker-compose up -d",\n    "docker:down": "docker-compose down",\n    "docker:logs": "docker-compose logs -f"\n  },\n  "devDependencies": {\n    "@typescript-eslint/eslint-plugin": "^6.13.0",\n    "@typescript-eslint/parser": "^6.13.0",\n    "eslint": "^8.55.0",\n    "prettier": "^3.1.0",\n    "typescript": "^5.3.3"\n  }\n}\n