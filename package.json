{
  "name": "ticash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @ticash/api",
    "build": "npm run build --workspace @ticash/shared && npm run build --workspace @ticash/api",
    "typecheck": "npm run typecheck --workspace @ticash/shared && npm run typecheck --workspace @ticash/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prisma:validate": "prisma validate --schema schema.prisma",
    "prisma:generate": "prisma generate --schema schema.prisma",
    "db:push": "node tools/run-prisma-schema.mjs db push --schema schema.prisma",
    "db:migrate": "node tools/run-prisma-schema.mjs migrate dev --schema schema.prisma",
    "db:seed": "node scripts/seed-corridors.mjs"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "prisma": "6.19.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
