generator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider = \"postgresql\"\n  url      = env(\"DATABASE_URL\")\n}\n\n// ============================================================================\n// AUTH & USERS\n// ============================================================================\n\nmodel User {\n  id                String   @id @default(cuid())\n  phone             String   @unique\n  fullName          String?\n  email             String?  @unique\n  passwordHash      String?\n  twoFactorEnabled  Boolean  @default(false)\n  twoFactorSecret   String?\n  lastLoginAt       DateTime?\n  loginAttempts     Int      @default(0)\n  lockedUntil       DateTime?\n  createdAt         DateTime @default(now())\n  updatedAt         DateTime @updatedAt\n\n  sessions          Session[]\n  kycData           KYCData?\n  recipients        Recipient[]\n  transfers         Transfer[] @relation(\"SenderTransfers\")\n  paymentMethods    PaymentMethod[]\n  ledgerEntries     LedgerEntry[]\n  auditLogs         AuditLog[]\n  notificationPrefs NotificationPreference?\n  disputes          Dispute[]\n\n  @@index([phone])\n  @@index([email])\n}\n\nmodel Session {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  deviceId        String?\n  deviceName      String?\n  ipAddress       String?\n  userAgent       String?\n  lastActivityAt  DateTime @default(now())\n  expiresAt       DateTime\n  createdAt       DateTime @default(now())\n\n  @@index([userId])\n  @@index([expiresAt])\n}\n\nmodel OTPRecord {\n  id         String   @id @default(cuid())\n  phone      String\n  code       String\n  attempts   Int      @default(0)\n  expiresAt  DateTime\n  createdAt  DateTime @default(now())\n  verifiedAt DateTime?\n\n  @@index([phone])\n  @@index([expiresAt])\n}\n\n// ============================================================================\n// KYC & VERIFICATION\n// ============================================================================\n\nmodel KYCData {\n  id                  String   @id @default(cuid())\n  userId              String   @unique\n  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  status              String   @default(\"PENDING\")\n  verificationLevel   String   @default(\"UNVERIFIED\")\n  \n  firstName           String?\n  lastName            String?\n  dateOfBirth         DateTime?\n  nationalId          String?   @unique\n  nationalIdType      String?\n  nationality         String?\n  \n  address             String?\n  city                String?\n  state               String?\n  postalCode          String?\n  country             String?\n  \n  idDocumentUrl       String?\n  idDocumentType      String?\n  selfieUrl           String?\n  livenessCheck       Boolean   @default(false)\n  \n  reviewedAt          DateTime?\n  reviewedBy          String?\n  rejectionReason     String?\n  \n  dailyLimit          Decimal   @default(5000)\n  monthlyLimit        Decimal   @default(50000)\n  \n  createdAt           DateTime  @default(now())\n  updatedAt           DateTime  @updatedAt\n\n  @@index([userId])\n  @@index([status])\n}\n\n// ============================================================================\n// RECIPIENTS\n// ============================================================================\n\nmodel Recipient {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  phone           String\n  fullName        String\n  provider        String\n  providerAccount String?\n  \n  isFavorite      Boolean  @default(false)\n  nickname        String?\n  \n  transfers       Transfer[] @relation(\"RecipientTransfers\")\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  @@unique([userId, phone, provider])\n  @@index([userId])\n}\n\n// ============================================================================\n// TRANSFERS\n// ============================================================================\n\nmodel Transfer {\n  id                  String   @id @default(cuid())\n  idempotencyKey      String   @unique\n  \n  senderId            String\n  sender              User     @relation(\"SenderTransfers\", fields: [senderId], references: [id])\n  \n  recipientId         String\n  recipient           Recipient @relation(\"RecipientTransfers\", fields: [recipientId], references: [id])\n  \n  amountHtg           Decimal\n  feeHtg              Decimal   @default(0)\n  totalHtg            Decimal\n  \n  exchangeRate        Decimal?\n  \n  status              String   @default(\"PENDING\")\n  \n  provider            String\n  providerRefId       String?\n  providerError       String?\n  \n  quoteExpiresAt      DateTime?\n  \n  payoutProviderId    String?\n  \n  notes               String?\n  description         String?\n  \n  createdAt           DateTime @default(now())\n  updatedAt           DateTime @updatedAt\n  processedAt         DateTime?\n  completedAt         DateTime?\n\n  ledgerEntries       LedgerEntry[]\n  providerTransaction ProviderTransaction?\n  receipt             Receipt?\n  dispute             Dispute?\n\n  @@unique([idempotencyKey])\n  @@index([senderId])\n  @@index([recipientId])\n  @@index([status])\n}\n\nmodel Receipt {\n  id                String   @id @default(cuid())\n  transferId        String   @unique\n  transfer          Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)\n  \n  receiptNumber     String   @unique\n  receiptData       Json\n  \n  createdAt         DateTime @default(now())\n\n  @@index([transferId])\n}\n\n// ============================================================================\n// WALLET & LEDGER\n// ============================================================================\n\nmodel WalletBalance {\n  id              String   @id @default(cuid())\n  userId          String   @unique\n  \n  availableUsd    Decimal  @default(0)\n  pendingUsd      Decimal  @default(0)\n  totalUsd        Decimal  @default(0)\n  \n  lastUpdatedAt   DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  @@index([userId])\n}\n\nmodel LedgerEntry {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  type            String\n  debitAccount    String\n  creditAccount   String\n  \n  amountUsd       Decimal\n  \n  transferId      String?\n  transfer        Transfer? @relation(fields: [transferId], references: [id])\n  paymentMethodId String?\n  \n  description     String\n  reference       String?\n  \n  createdAt       DateTime @default(now())\n\n  @@index([userId])\n  @@index([type])\n}\n\n// ============================================================================\n// PAYMENTS & FUNDING\n// ============================================================================\n\nmodel PaymentMethod {\n  id              String   @id @default(cuid())\n  userId          String\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  type            String\n  provider        String\n  isDefault       Boolean  @default(false)\n  \n  providerToken   String?\n  last4           String?\n  expiryMonth     Int?\n  expiryYear      Int?\n  \n  isVerified      Boolean  @default(false)\n  isActive        Boolean  @default(true)\n  \n  fundingRecords  FundingRecord[]\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  @@index([userId])\n}\n\nmodel FundingRecord {\n  id              String   @id @default(cuid())\n  paymentMethodId String\n  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)\n  \n  amountUsd       Decimal\n  \n  providerRefId   String?\n  \n  status          String   @default(\"PENDING\")\n  \n  metadata        Json?\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  completedAt     DateTime?\n\n  @@index([paymentMethodId])\n  @@index([status])\n}\n\n// ============================================================================\n// PROVIDER TRANSACTIONS\n// ============================================================================\n\nmodel ProviderTransaction {\n  id              String   @id @default(cuid())\n  transferId      String   @unique\n  transfer        Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)\n  \n  provider        String\n  status          String   @default(\"PENDING\")\n  \n  providerTxId    String?  @unique\n  providerError   String?\n  \n  requestData     Json?\n  responseData    Json?\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n  completedAt     DateTime?\n\n  @@index([provider])\n  @@index([status])\n}\n\n// ============================================================================\n// IDEMPOTENCY & COMPLIANCE\n// ============================================================================\n\nmodel IdempotencyKey {\n  id              String   @id @default(cuid())\n  key             String   @unique\n  userId          String\n  \n  method          String\n  path            String\n  request         Json\n  \n  response        Json\n  status          Int\n  \n  expiresAt       DateTime\n  createdAt       DateTime @default(now())\n\n  @@index([userId])\n  @@index([expiresAt])\n}\n\n// ============================================================================\n// NOTIFICATIONS\n// ============================================================================\n\nmodel NotificationPreference {\n  id              String   @id @default(cuid())\n  userId          String   @unique\n  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  \n  emailNotifications    Boolean @default(true)\n  smsNotifications      Boolean @default(true)\n  pushNotifications     Boolean @default(true)\n  \n  transferUpdates       Boolean @default(true)\n  kycUpdates            Boolean @default(true)\n  promotions            Boolean @default(false)\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n}\n\nmodel Notification {\n  id              String   @id @default(cuid())\n  userId          String?\n  \n  type            String\n  title           String\n  message         String\n  data            Json?\n  \n  channel         String\n  recipient       String\n  \n  status          String   @default(\"PENDING\")\n  sentAt          DateTime?\n  readAt          DateTime?\n  \n  createdAt       DateTime @default(now())\n\n  @@index([userId])\n  @@index([status])\n}\n\n// ============================================================================\n// DISPUTES & REFUNDS\n// ============================================================================\n\nmodel Dispute {\n  id              String   @id @default(cuid())\n  transferId      String   @unique\n  transfer        Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)\n  userId          String\n  user            User     @relation(fields: [userId], references: [id])\n  \n  status          String   @default(\"OPEN\")\n  reason          String\n  description     String\n  \n  resolutionNotes String?\n  resolvedAt      DateTime?\n  \n  createdAt       DateTime @default(now())\n  updatedAt       DateTime @updatedAt\n\n  @@index([userId])\n  @@index([status])\n}\n\n// ============================================================================\n// AUDIT TRAIL\n// ============================================================================\n\nmodel AuditLog {\n  id              String   @id @default(cuid())\n  userId          String?\n  user            User?    @relation(fields: [userId], references: [id])\n  \n  action          String\n  entity          String\n  entityId        String?\n  \n  changes         Json?\n  metadata        Json?\n  ipAddress       String?\n  userAgent       String?\n  \n  createdAt       DateTime @default(now())\n\n  @@index([userId])\n  @@index([action])\n  @@index([entity])\n}\n