<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 uses a 288dp icon canvas. Keep the F inside its 192dp safe circle.
     The same 160dp transparent image canvas is used before Android 12. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape><solid android:color="@android:color/transparent" /></shape>
    </item>
    <item android:width="160dp" android:height="160dp" android:gravity="center"
        android:drawable="@drawable/flupflap_f_glossy" />
</layer-list>
