# Environment\nNODE_ENV=development\n\n# Database\nDATABASE_URL=postgresql://ticash:ticash_dev_password@localhost:5432/ticash\n\n# API\nPORT=4000\nCORS_ORIGIN=http://localhost:3000,http://localhost:8081\n\n# JWT\nJWT_SECRET=dev-secret-key-change-in-production\nJWT_EXPIRES_IN=7d\n\n# Logging\nLOG_LEVEL=info\n\n# OTP\nOTP_EXPIRY_MINUTES=10\nOTP_LENGTH=6\n\n# Stripe (Sandbox mode)\nSTRIPE_SECRET_KEY=sk_test_\nSTRIPE_PUBLISHABLE_KEY=pk_test_\n\n# PayPal (Sandbox mode)\nPAYPAL_CLIENT_ID=sandbox_\nPAYPAL_CLIENT_SECRET=sandbox_\nPAYPAL_MODE=sandbox\n\n# SMS Service (Optional)\nTWILIO_ACCOUNT_SID=\nTWILIO_AUTH_TOKEN=\nTWILIO_PHONE_NUMBER=\n\n# Email Service\nSENDGRID_API_KEY=\nSENDGRID_FROM_EMAIL=noreply@ticash.app\n\n# MonCash Provider (Mock mode only)\nMONCASH_API_KEY=mock_key_sandbox_only\nMONCASH_MERCHANT_ID=mock_merchant_sandbox_only\n\n# NatCash Provider (Mock mode only)\nNATCASH_API_KEY=mock_key_sandbox_only\nNATCASH_MERCHANT_ID=mock_merchant_sandbox_only\n