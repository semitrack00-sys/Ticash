{\n  \"name\": \"@ticash/api\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"main\": \"dist/index.js\",\n  \"scripts\": {\n    \"dev\": \"tsx watch src/index.ts\",\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\",\n    \"lint\": \"eslint src --ext .ts\",\n    \"format\": \"prettier --write \\\"src/**/*.ts\\\"\",\n    \"type-check\": \"tsc --noEmit\",\n    \"test\": \"vitest\",\n    \"test:run\": \"vitest run\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:push\": \"prisma db push\",\n    \"db:studio\": \"prisma studio\"\n  },\n  \"dependencies\": {\n    \"express\": \"^4.18.2\",\n    \"cors\": \"^2.8.5\",\n    \"helmet\": \"^7.1.0\",\n    \"zod\": \"^3.22.4\",\n    \"bcryptjs\": \"^2.4.3\",\n    \"jsonwebtoken\": \"^9.1.2\",\n    \"uuid\": \"^9.0.1\",\n    \"@prisma/client\": \"^5.7.0\",\n    \"dotenv\": \"^16.3.1\",\n    \"pino\": \"^8.17.2\",\n    \"pino-http\": \"^8.5.0\",\n    \"express-rate-limit\": \"^7.1.5\"\n  },\n  \"devDependencies\": {\n    \"@types/express\": \"^4.17.21\",\n    \"@types/node\": \"^20.10.0\",\n    \"@types/bcryptjs\": \"^2.4.6\",\n    \"@types/jsonwebtoken\": \"^9.0.7\",\n    \"typescript\": \"^5.3.3\",\n    \"tsx\": \"^4.7.0\",\n    \"eslint\": \"^8.55.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^6.13.0\",\n    \"@typescript-eslint/parser\": \"^6.13.0\",\n    \"prettier\": \"^3.1.0\",\n    \"prisma\": \"^5.7.0\",\n    \"vitest\": \"^1.0.0\"\n  }\n}\n